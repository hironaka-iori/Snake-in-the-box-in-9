theorem cycles_checked : cycles.all cycleCheck = true := by decide

theorem cycles_excluded {m : Nat} (p : Snake m) :
    ∀ c ∈ cycles, ¬ (∀ v ∈ c, InPath p v) := by
  intro c hc hs
  have h := cycleCheck_sound c (List.all_eq_true.mp cycles_checked c hc)
  have hne : c.toFinset.Nonempty := by
    cases c with
    | nil => exact False.elim (h.1 rfl)
    | cons a tail => exact ⟨a, by simp⟩
  apply two_neighbor_set_not_selected p c.toFinset hne
  · intro v hv
    obtain ⟨a, ha, b, hb, hab, hva, hvb⟩ := h.2 v (List.mem_toFinset.mp hv)
    exact ⟨a, List.mem_toFinset.mpr ha, b, List.mem_toFinset.mpr hb, hab, hva, hvb⟩
  · intro v hv
    exact hs v (List.mem_toFinset.mp hv)

#print axioms cycles_checked
#print axioms cycles_excluded
end Snake9.WindowCycles
