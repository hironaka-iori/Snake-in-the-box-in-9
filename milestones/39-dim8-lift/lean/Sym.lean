theorem gen_nb_F : ∀ c : Fin 36, ∀ u : Fin 256, ∀ a : Fin 8,
    gen c.val (u.val ^^^ 2 ^ a.val) = gen c.val u.val ^^^ 2 ^ (dmap c.val a.val)
  | ⟨0, _⟩ => gen_nb_0
  | ⟨1, _⟩ => gen_nb_1
