theorem dmap_F : ∀ c : Fin 36, ∀ a : Fin 8, dmap c.val a.val < 8 ∧ dmap c.val (dmap c.val a.val) = a.val := by decide

theorem gen_lt {c u : Nat} (hc : c < 36) (hu : u < 256) : gen c u < 256 := (gen_facts_F ⟨c, hc⟩ ⟨u, hu⟩).1
theorem gen_gen {c u : Nat} (hc : c < 36) (hu : u < 256) : gen c (gen c u) = u := (gen_facts_F ⟨c, hc⟩ ⟨u, hu⟩).2
theorem gen_nb {c u a : Nat} (hc : c < 36) (hu : u < 256) (ha : a < 8) :
    gen c (nb u a) = nb (gen c u) (dmap c a) := gen_nb_F ⟨c, hc⟩ ⟨u, hu⟩ ⟨a, ha⟩
theorem dmap_lt {c a : Nat} (hc : c < 36) (ha : a < 8) : dmap c a < 8 := (dmap_F ⟨c, hc⟩ ⟨a, ha⟩).1
theorem dmap_dmap {c a : Nat} (hc : c < 36) (ha : a < 8) : dmap c (dmap c a) = a := (dmap_F ⟨c, hc⟩ ⟨a, ha⟩).2

