import CubeBridge5
/-! Automorphisms of Q8 generated by the 28 coordinate transpositions (codes 0-27, in `pairs8` order)
and the 8 coordinate flips (codes 28-35).  Each generator is an involution that maps neighbours to
neighbours; a `Pit` is transported along it. -/
set_option linter.deprecated false
set_option maxRecDepth 200000
namespace Dim8Lift.Sym
open Dim8Lift Dim8Lift.Cube

def tA (c : Nat) : Nat := (pairs8.getD c (0, 0)).1
def tB (c : Nat) : Nat := (pairs8.getD c (0, 0)).2

def gen (c u : Nat) : Nat :=
  if c < 28 then (if u.testBit (tA c) != u.testBit (tB c) then u ^^^ (2 ^ tA c + 2 ^ tB c) else u)
  else u ^^^ 2 ^ (c - 28)

def dmap (c a : Nat) : Nat :=
  if c < 28 then (if a = tA c then tB c else if a = tB c then tA c else a) else a

set_option maxHeartbeats 0 in
theorem gen_facts_F : ∀ c : Fin 36, ∀ u : Fin 256, gen c.val u.val < 256 ∧ gen c.val (gen c.val u.val) = u.val := by
  decide
