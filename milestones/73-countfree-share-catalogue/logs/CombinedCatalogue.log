partial_catalogue_share : RefutedShare (winOf [0, 1, 2, 0, 3, 2]) broadBounds 12 15 →
  RefutedShare (winOf [0, 1, 2, 0, 3, 4]) broadBounds 12 19 →
    RefutedShare (winOf [0, 1, 2, 3, 0, 1]) broadBounds 12 15 →
      RefutedShare (winOf [0, 1, 2, 3, 4, 0]) broadBounds 12 15 →
        RefutedShare (winOf [0, 1, 2, 3, 4, 5]) broadBounds 12 15 →
          ∀ {m : ℕ} (p : Snake m) (r : ℕ),
            r + 6 ≤ m → windowLower p r ≤ (List.map (fun i => coreShare 12 p (r + i + 1)) (List.range 5)).sum
