def jointSum (S : Nat → Bool) : Nat := absentCorners S centre2.v centre2.d₁ centre2.d₂ + absentCorners S centre6.v centre6.d₁ centre6.d₂

theorem old_check : oldCtrs.all (ctrOK meaning (centresK window bounds)) = true := by decide +kernel
theorem clause_check : ckAll meaning ctrs window tags ordinaryRaw = true := by decide +kernel
theorem primitive_check : jointCtr.lits.all (baseOK meaning) = true := by decide +kernel
theorem negative_check : jointCtr.lits.all (negP meaning) = true := by decide +kernel
theorem corner_check : jointCtr.lits.map (vl meaning) = jointCentres.flatMap corners := by decide +kernel

theorem joint_good (S E : Nat → Bool) (h : jointSum S ≤ 7) :
    JointTags.Good S E meaning jointCtr := by
  refine ⟨primitive_check, ?_⟩
  have hc := JointTags.multi_centre_count (S := S) (E := E)
    jointCtr.lits jointCentres negative_check corner_check
  change jointCtr.lits.countP (lv (base S E meaning)) ≤ 7
  rw [hc]
  simpa [jointCentres, jointSum] using h

theorem endpoint_negative : endpointLits.all (negE meaning) = true := by decide +kernel
theorem endpoint_meanings : endpointLits.map (vl meaning) = endpointVertices := by decide +kernel

theorem sat (S E : Nat → Bool) (ax : Axioms S E window (centresOf window bounds))
    (h : jointSum S ≤ 7) (hnone : ∀ v ∈ endpointVertices, E v = false) : ∃ τ, cnfTrue τ cnf = true := by
  have axK : Axioms S E window (centresK window bounds) := by
    rw [← centresK_eq]; exact ax
  have hv : JointTags.Valid S E meaning ctrs := by
    apply JointTags.valid_append old_check ?_ axK
    intro ct hc
    have he : ct = jointCtr := by simpa using hc
    subst ct
    exact joint_good S E h
  have ho := JointTags.sound meaning ctrs window (centresK window bounds)
    tags ordinaryRaw clause_check S E hv axK
  have he := EndpointUnits.sound S E meaning ctrs endpointLits endpoint_negative (by
    intro l hl
    apply hnone
    rw [← endpoint_meanings]
    exact List.mem_map_of_mem hl)
  refine ⟨tau S E meaning ctrs, ?_⟩
  unfold cnf raw
  rw [List.map_append]
  unfold cnfTrue
  rw [List.all_append]
  rw [Bool.and_eq_true]
  exact ⟨ho,he⟩
#print axioms sat
end Snake9.LocalWindow.EndpointPair451
