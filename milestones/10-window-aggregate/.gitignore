.build/
# DRUP proofs of the direction-aware exclusions are ~250 MB; the index files
# record their SHA256 and scripts/certify_direction.py regenerates them.
certificates/direction/*.drup.gz
# six-centre set: 2546 CNFs (~250 MB) are regenerated by certify_direction.py; the index
# records their SHA256. Already-tracked k=4/k=5 CNFs stay tracked.
certificates/direction/*.cnf.gz
data/*.judge-progress.jsonl
