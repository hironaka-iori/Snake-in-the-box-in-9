@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+# Post-production steps of the unconditional 233 (CERT-PROGRESS.md, "Projection", "Then:").
+# Run only after `prod233.py` has logged {"done": "all certificates built"} and exited.
+#
+#   CERT233_SCR=/home/user/cert233work bash milestones/33-233-lean/certify/post233.sh
+#
+# Steps (each aborts the script on failure; the whole run is logged to $CERT233_SCR/logs/post233.log):
+#   0. preconditions: no prod/pregen/guarded build running, free disk, every certificate built
+#      (`cert233.py status`: seeds and share keys, Cnf and replay .olean);
+#   1. `cert233.py final` into a scratch directory first; the 30 modules must be byte-identical to
+#      the ones in work/final_lean (written 10 Nov 14:38), so the real `final` is a no-op and the
+#      built chunks LocalWindowDirUnsatN6SB233_10..13, LocalWindowDirKeys*6SB233 and
+#      LocalWindowDirUnsatR6SB233 keep their mtimes (FORCE_FINAL=1 continues past a difference);
+#      then the real `final` (it only rewrites files whose text changed) and an mtime check;
+#   2. staleness simulation of the closure of the two aggregates (guarded_lake_build's own
+#      closure()/uptodate() with --trust-mtime): only the 23 expected modules may be stale;
+#   3. guarded build (--direct --trust-mtime --no-ilean) of LocalWindowDirUnsat6SB233 and
+#      LocalWindowShareUnsat6SB233; their `#print axioms` lines are checked;
+#   4. floors overlay (symlinks) in a NEW directory; the two port top-level .olean files that the core
+#      also has (byte-identical copies, `cp -p` of 10 Nov) are removed from it, otherwise
+#      chain_audit.py refuses the extra path ("would shadow");
+#   5. chain_audit.py --target UpperBound233 --reuse --extra-lean-path NEWDIR; prints the axioms.
+set -euo pipefail
+
+ROOT=/home/user/Snake-in-the-box-in-9
+export CERT233_SCR=${CERT233_SCR:-/home/user/cert233work}
+LEANBIN=/home/user/lean-deps/toolchain/lean-4.19.0-linux/bin
+MATHLIB=/home/user/lean-deps/mathlib4
+LEAN=$ROOT/work/final_lean
+LIB=$LEAN/.lake/build/lib/lean
+CHAIN=$ROOT/work/spectral/.verification/chain
+CERT=$ROOT/milestones/33-233-lean/certify/cert233.py
+GLB=$ROOT/work/guarded_lake_build.py
+PORT=/home/user/floors233/.lake/build/lib/lean
+NEWDIR=${NEWDIR:-/home/user/floors233-lp-final}
+AUDIT_LOG=outputs/upper-bound-233-audit-linux.log      # relative to $ROOT (chain_audit opens it there)
+GLOG=$LEAN/.lake/guarded_build_233final.jsonl
+MIN_DISK_MB=${MIN_DISK_MB:-2000}   # 1.5 GB floor + ~0.15 GB overlay + aggregates/audit + margin
+LOG=$CERT233_SCR/logs/post233.log
+export PATH=$LEANBIN:$PATH
+
+mkdir -p "$CERT233_SCR/logs"
+exec > >(tee -a "$LOG") 2>&1
+echo "=== post233.sh start $(date -u +%FT%TZ)"
+
+free_mb() { df -Pm / | awk 'NR==2 {print $4}'; }
+need_disk() {
+  local f; f=$(free_mb)
+  echo "free disk: $f MB (need >= $1 MB)"
+  if [ "$f" -lt "$1" ]; then echo "ABORT: not enough free disk"; exit 1; fi
+}
+
+# ---------------------------------------------------------------- 0. preconditions
+if pgrep -f 'prod233\.py|pregen233\.py|guarded_lake_build\.py|cert233\.py (cores|cnf|replay)' >/dev/null; then
+  echo "ABORT: production processes still running:"; pgrep -af 'prod233\.py|pregen233\.py|guarded_lake_build\.py|cert233\.py' || true
+  exit 1
+fi
+if ! tail -n 1 "$ROOT/milestones/33-233-lean/certify/data/prod6SB233.jsonl" | grep -q '"done"'; then
+  echo "WARNING: last line of prod6SB233.jsonl is not {\"done\": ...}; relying on the status counts below"
+fi
+need_disk "$MIN_DISK_MB"
+[ -x "$LEANBIN/lean" ] && [ -x "$LEANBIN/lake" ] || { echo "ABORT: no lean/lake in $LEANBIN"; exit 1; }
+[ "$(git -C "$MATHLIB" rev-parse HEAD)" = c44e0c8ee63ca166450922a373c7409c5d26b00b ] || { echo "ABORT: mathlib pin"; exit 1; }
+[ -d "$PORT/LocalWindowCnf" ] || { echo "ABORT: no floors port at $PORT"; exit 1; }
+[ ! -e "$NEWDIR" ] || { echo "ABORT: $NEWDIR exists (floors_overlay.py needs a new directory; set NEWDIR=...)"; exit 1; }
+
+echo "--- cert233.py status"
+python3 "$CERT" status | tee "$CERT233_SCR/post233_status.json"
+python3 - "$CERT233_SCR/post233_status.json" <<'EOF'
+import json, sys
+r = json.load(open(sys.argv[1]))
+tot = r['seeds'] + r['share']
+built = r['seed_unsat_built'] + r['share_unsat_built']
+print(f"certificates: {built} / {tot} replay .olean ({r['seed_unsat_built']}/{r['seeds']} seeds, "
+      f"{r['share_unsat_built']}/{r['share']} share); Cnf {r['seed_cnf_built']}/{r['seeds']}, {r['share_cnf_built']}/{r['share']}")
+ok = (r['seed_unsat_built'] == r['seed_cnf_built'] == r['seeds'] and
+      r['share_unsat_built'] == r['share_cnf_built'] == r['share'] and
+      r['cores_plain'] == r['new_plain'] + r['h8'] and r['cores_share'] == r['share'])
+if not ok:
+    sys.exit('ABORT: not every certificate is built')
+EOF
+
+# ---------------------------------------------------------------- 1. final
+echo "--- 1. cert233.py final (dry run into scratch, then in place)"
+FC=$(mktemp -d "$CERT233_SCR/final_check.XXXXXX")
+python3 "$CERT" final --out "$FC" | tee "$FC/final.out"
+grep -q '; 0 certificate replays not generated or built yet' "$FC/final.out" || { echo "ABORT: final reports missing certificates"; exit 1; }
+ndiff=0
+for f in "$FC"/*.lean; do
+  b=$(basename "$f")
+  if ! cmp -s "$f" "$LEAN/$b"; then echo "  differs from work/final_lean: $b"; ndiff=$((ndiff + 1)); fi
+done
+echo "final dry run: $(ls "$FC"/*.lean | wc -l) modules, $ndiff differ from work/final_lean"
+if [ "$ndiff" -ne 0 ] && [ "${FORCE_FINAL:-0}" != 1 ]; then
+  echo "ABORT: final would rewrite $ndiff modules (they and their dependents would be rebuilt); inspect $FC, rerun with FORCE_FINAL=1 to accept"
+  exit 1
+fi
+KEEP="LocalWindowDirKeys6SB233 LocalWindowDirKeysN6SB233 LocalWindowDirKeysR6SB233 LocalWindowDirUnsatR6SB233 LocalWindowDirUnsatN6SB233_10 LocalWindowDirUnsatN6SB233_11 LocalWindowDirUnsatN6SB233_12 LocalWindowDirUnsatN6SB233_13"
+before=$(for m in $KEEP; do stat -c '%Y %n' "$LEAN/$m.lean"; done)
+python3 "$CERT" final
+after=$(for m in $KEEP; do stat -c '%Y %n' "$LEAN/$m.lean"; done)
+if [ "$before" != "$after" ] && [ "${FORCE_FINAL:-0}" != 1 ]; then
+  echo "ABORT: final touched built modules:"; diff <(echo "$before") <(echo "$after") || true; exit 1
+fi
+grep -lE 'sorry|native_decide|^axiom' "$LEAN"/LocalWindowDir*6SB233*.lean "$LEAN"/LocalWindowShareUnsat6SB233*.lean \
+  "$ROOT/work/spectral/stronger/UpperBound233.lean" && { echo "ABORT: sorry/native_decide/axiom in a generated module"; exit 1; } || true
+rm -rf "$FC"
+
+# ---------------------------------------------------------------- 2. staleness simulation
+echo "--- 2. staleness simulation (guarded_lake_build closure/uptodate, --trust-mtime)"
+python3 -I - "$GLB" "$LEAN" <<'EOF'
+import importlib.util, sys
+from pathlib import Path
+spec = importlib.util.spec_from_file_location('glb', sys.argv[1])
+g = importlib.util.module_from_spec(spec); spec.loader.exec_module(g)
+g.ROOT = Path(sys.argv[2])
+deps = g.closure(['LocalWindowDirUnsat6SB233', 'LocalWindowShareUnsat6SB233'], True)
+st = {}
+def s(m):
+    if m not in st:
+        st[m] = any(s(d) for d in deps[m]) or not g.uptodate(m, deps[m])
+    return st[m]
+for m in deps:
+    s(m)
+stale = sorted(m for m in deps if st[m])
+expected = ({'LocalWindowDirUnsat6SB233', 'LocalWindowShareUnsat6SB233'}
+            | {f'LocalWindowDirUnsatN6SB233_{c}' for c in (*range(10), 14)}
+            | {f'LocalWindowShareUnsat6SB233_{c}' for c in range(10)})
+bad = [m for m in stale if m not in expected]
+print(f'closure {len(deps)} modules ({len(g.PREBUILT)} prebuilt .olean without source); stale {len(stale)}:', stale)
+if bad:
+    sys.exit(f'ABORT: stale modules outside the expected 23 (would be recompiled): {bad[:30]}')
+EOF
+
+# ---------------------------------------------------------------- 3. guarded build of the aggregates
+echo "--- 3. guarded build of LocalWindowDirUnsat6SB233 and LocalWindowShareUnsat6SB233"
+need_disk 1700
+t0=$(date +%s)
+( cd "$LEAN" && LEAN_PATH=$CHAIN nice -n 10 python3 "$GLB" --root "$LEAN" --direct --trust-mtime --no-ilean \
+    --jobs 3 --heavy '^LocalWindow(DirUnsat|ShareUnsat)6SB233$' --heavy-jobs 1 \
+    --rss-cap-gb 10 --min-free-gb 4 --floor-gb 1.5 --min-disk-mb 1500 \
+    --log "$GLOG" LocalWindowDirUnsat6SB233 LocalWindowShareUnsat6SB233 )
+echo "guarded build: $(( $(date +%s) - t0 )) s"
+for m in LocalWindowDirUnsat6SB233 LocalWindowShareUnsat6SB233; do
+  [ -f "$LIB/$m.olean" ] || { echo "ABORT: $m.olean missing"; exit 1; }
+  ax=$(grep -h "depends on axioms" "$LEAN/.lake/guarded_logs/$m.log" || true)
+  echo "$m: $ax"
+  [ -n "$ax" ] && ! echo "$ax" | grep -qvE "depends on axioms: \[((propext|Classical\.choice|Quot\.sound)(, )?)*\]$" \
+    || { echo "ABORT: unexpected axioms in $m"; exit 1; }
+done
+grep -E '"module": "LocalWindow(DirUnsat|ShareUnsat)6SB233(_[0-9]+)?"|"module": "LocalWindowDirUnsatN6SB233_[0-9]+"' "$GLOG" | grep -v uptodate | tail -25 || true
+
+# ---------------------------------------------------------------- 4. floors overlay
+echo "--- 4. floors overlay into $NEWDIR"
+need_disk 1700
+python3 -I "$ROOT/milestones/33-233-lean/scripts/floors_overlay.py" "$PORT" "$NEWDIR"
+# the core holds byte-identical copies of these two port modules; a symlink to the port file would make
+# chain_audit.py stop with "would shadow"; without it Lean finds the core copy
+for f in LocalWindowTagsShare.olean LocalWindowTagsSharePacked.olean; do
+  if [ -e "$LIB/$f" ]; then
+    cmp -s "$PORT/$f" "$LIB/$f" || { echo "ABORT: $f differs between the port and the core"; exit 1; }
+    rm "$NEWDIR/$f"; echo "removed overlay link $f (core copy is identical)"
+  fi
+done
+nd=$(find "$NEWDIR" -xtype l | wc -l)
+echo "overlay: $(find "$NEWDIR" -type l | wc -l) symlinks, $nd dangling, $(du -sm "$NEWDIR" | cut -f1) MB"
+[ "$nd" -eq 0 ] || { echo "ABORT: dangling links in the overlay"; exit 1; }
+python3 -I - "$NEWDIR" "$LIB" "$CHAIN" <<'EOF'
+import sys
+from pathlib import Path
+d, core, chain = map(Path, sys.argv[1:])
+bad = [str(f) for f in d.rglob('*.olean') for q in (core / f.relative_to(d), chain / f.relative_to(d))
+       if q.exists() and q.resolve() != f.resolve()]
+if bad:
+    sys.exit(f'ABORT: overlay would shadow {len(bad)} files, e.g. {bad[:5]}')
+print('shadow check (as chain_audit.py): ok')
+EOF
+
+# ---------------------------------------------------------------- 5. chain audit
+echo "--- 5. chain_audit.py --target UpperBound233"
+need_disk 1600
+cd "$ROOT"
+t0=$(date +%s)
+set +e
+python3 work/spectral/chain_audit.py --mathlib-dir "$MATHLIB" --target UpperBound233 --reuse \
+  --extra-lean-path "$NEWDIR" --log "$AUDIT_LOG" \
+  --axioms Snake9.upper_bound_233 Snake9.verified_interval_191_233
+rc=$?
+set -e
+echo "chain audit: exit $rc, $(( $(date +%s) - t0 )) s"
+echo "=== axioms ($AUDIT_LOG, this run):"
+tail -n 12 "$AUDIT_LOG" | grep -E "depends on axioms|AXIOM AUDIT|FAILED|chain wall" || true
+echo "free disk at end: $(free_mb) MB"
+echo "=== post233.sh end $(date -u +%FT%TZ): $([ $rc -eq 0 ] && echo 'AXIOM AUDIT PASSED' || echo 'AXIOM AUDIT FAILED')"
+exit $rc
diff --git a/milestones/33-233-lean/certify/pregen233.py b/milestones/33-233-lean/certify/pregen233.py
new file mode 100644
index 00000000..bbf69877
--- /dev/null
+++ b/milestones/33-233-lean/certify/pregen233.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Generate replay sources ahead of `prod233.py`, so its generation phase (cadical 8 seeds x 5 rounds
+per big core, serial) overlaps the kernel builds of the previous batch.
+
+Each worker (`--worker i`) has its own scratch directory ($CERT233_SCR/pregen<i>, set before
+`cert233` is imported) and its own output tree; it takes, in `work_items` order, the first unbuilt
+certificate that has no source in `work/final_lean` yet, is not in the batch prod is generating or
+building now (read from the command lines of its `cert233.py replay` / `guarded_lake_build.py`
+children), and is not claimed by another worker (an O_EXCL file in $CERT233_SCR/pregen_claims).
+It runs `cert233.py replay --out <own tree> NAME` and then moves the source into
+`work/final_lean/LocalWindowUnsat` unless a source or `.olean` appeared there meanwhile (prod
+generated it itself: the copy is dropped).  It also helps prod's current replay from the end of its
+list backwards (prod goes forwards and skips names whose source exists).  Touch
+$CERT233_SCR/pregen_stop<i> to make worker i exit before its next item (used by supervisor233.py).  The generated source is the same as prod's own
+(`cert233.py replay` is deterministic given the key), so prod builds it unchanged.  Only the
+--ahead first eligible certificates are taken; it stops below --min-disk-mb.
+
+  CERT233_SCR=/home/user/cert233work setsid nohup nice -n 12 python3 pregen233.py --worker 0 &
+"""
+import argparse, json, os, subprocess, sys, time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, '..', '..', '..'))
+LEAN = os.path.join(ROOT, 'work', 'final_lean')
+BASE = os.environ.get('CERT233_SCR', '/home/user/cert233work')
+
+
+def _names(line):
+    for w in line.split():
+        if w.startswith('LocalWindowUnsat.'):
+            w = w.split('.', 1)[1]
+        if w[:1] in 'ST' and 'A' in w and '/' not in w and '-' not in w:
+            yield w
+
+
+def prod_current():
+    """(names of prod's current replay generation, in its order; names of its guarded build)."""
+    out = subprocess.run(['ps', '-eo', 'args'], capture_output=True, text=True).stdout
+    rep, build = [], set()
+    for line in out.splitlines():
+        if 'pregen' in line:
+            continue
+        if 'cert233.py replay' in line:
+            rep += [w for w in _names(line) if w not in rep]
+        elif 'guarded_lake_build.py' in line:
+            build.update(_names(line))
+    return rep, build
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--worker', type=int, required=True)
+    ap.add_argument('--ahead', type=int, default=30)
+    ap.add_argument('--min-disk-mb', type=int, default=3000)
+    ap.add_argument('--seed-jobs', default='1', help="passed to cert233.py replay ('auto': use idle cores)")
+    a = ap.parse_args()
+    scr = os.path.join(BASE, 'pregen%d' % a.worker)
+    os.makedirs(scr, exist_ok=True)
+    os.environ['CERT233_SCR'] = scr
+    sys.path.insert(0, HERE)
+    import cert233 as C
+    claims = os.path.join(BASE, 'pregen_claims')
+    os.makedirs(claims, exist_ok=True)
+    out = os.path.join(scr, 'out')
+    stop = os.path.join(BASE, 'pregen_stop%d' % a.worker)   # touch to stop after the current item
+    ns = C.argparse.Namespace(keys_from='', plan=C.PLAN, core=C.CORE, names=[])
+    olean = lambda n: os.path.exists(os.path.join(LEAN, '.lake/build/lib/lean/LocalWindowUnsat', n + '.olean'))  # noqa
+    src = lambda n: os.path.join(LEAN, 'LocalWindowUnsat', n + '.lean')  # noqa
+    log = lambda r: print(json.dumps({'t': round(time.time()), **r}), flush=True)  # noqa
+    while True:
+        if C.disk_free_mb() < a.min_disk_mb:
+            log({'stop': 'disk', 'free_mb': C.disk_free_mb()})
+            return
+        items = [it[2] for h, it, m in C.work_items(ns, {'seed', 'share'}) if not olean(it[2])]
+        if not items:
+            log({'done': 'all built'})
+            return
+        if os.path.exists(stop):
+            os.remove(stop)
+            log({'stop': 'requested'})
+            return
+        rep, build = prod_current()
+        # prod's own replay goes through its list in order and skips names whose source exists:
+        # help it from the end of its list backwards, then take the items after its batch.
+        mine = [n for n in reversed(rep) if not os.path.exists(src(n)) and not olean(n)]
+        todo = mine + [n for n in items if n not in rep and n not in build and not os.path.exists(src(n))][:a.ahead]
+        pick = None
+        for n in todo:
+            try:
+                os.close(os.open(os.path.join(claims, n), os.O_CREAT | os.O_EXCL | os.O_WRONLY))
+                pick = n
+                break
+            except FileExistsError:
+                continue
+        if pick is None:
+            time.sleep(60)
+            continue
+        t0 = time.time()
+        r = subprocess.run([sys.executable, os.path.join(HERE, 'cert233.py'), 'replay', '--kinds', 'seed,share',
+                            '--min-disk-mb', str(a.min_disk_mb), '--seed-jobs', a.seed_jobs, '--out', out, pick],
+                           capture_output=True, text=True, env=dict(os.environ, CERT233_SCR=scr))
+        p = os.path.join(out, 'LocalWindowUnsat', pick + '.lean')
+        if r.returncode != 0 or not os.path.exists(p):
+            log({'name': pick, 'failed': r.returncode, 'stderr': r.stderr[-800:]})
+            if os.path.exists(p):
+                os.remove(p)
+            continue   # the claim stays: prod generates this one itself
+        if os.path.exists(src(pick)) or olean(pick):
+            # prod generated it meanwhile (the same deterministic text): drop the copy.  A source prod is
+            # still writing is overwritten by identical text; prod builds only after its replay ends.
+            os.remove(p)
+            log({'name': pick, 'dropped': 'prod got there first', 's': round(time.time() - t0)})
+        else:
+            os.replace(p, src(pick))
+            log({'name': pick, 'moved': True, 's': round(time.time() - t0)})
+
+
+if __name__ == '__main__':
+    main()
diff --git a/milestones/33-233-lean/certify/supervisor233.py b/milestones/33-233-lean/certify/supervisor233.py
new file mode 100644
index 00000000..774abd27
--- /dev/null
+++ b/milestones/33-233-lean/certify/supervisor233.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Keep the cores busy during the 233 certificate production by adding and retiring
+`pregen233.py` workers.
+
+Every --interval seconds it counts the busy cores: `lean` processes (builds of prod's guarded build)
+plus, for each running `cert233.py replay` (prod's own and the workers'), its cadical processes (at
+least one).  Workers it starts pass `--seed-jobs auto` (parallel cadical runs on idle cores).
+
+* busy < --cores, MemAvailable >= --start-mem-gb, free disk >= --min-disk-mb + 500, and no start in
+  the last --start-gap seconds: start a worker with the lowest free index (at most --max-workers).
+* busy > --cores + --over and more than --min-workers workers: ask the newest worker to stop after
+  its current item (touch $CERT233_SCR/pregen_stop<i>; one request at a time).
+* Workers already running when it starts (older code without the stop file) are stopped as soon
+  as they are between two items (no replay child); the rules above then start new ones.
+* MemAvailable < --kill-mem-gb: kill the newest worker above --min-workers now, with its replay,
+  and release its claim (its item is redone later).
+
+Workers it starts use `--min-disk-mb` (they exit below it).  It never touches prod or the builds; it also
+works while prod is stopped (workers exit by themselves once everything is built).
+Log: JSON lines on stdout.
+
+  CERT233_SCR=/home/user/cert233work setsid nohup python3 supervisor233.py >> $CERT233_SCR/logs/supervisor.log 2>&1 &
+"""
+import argparse, json, os, re, shutil, signal, subprocess, sys, time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+BASE = os.environ.get('CERT233_SCR', '/home/user/cert233work')
+LEANBIN = '/home/user/lean-deps/toolchain/lean-4.19.0-linux/bin'
+
+
+def log(**r):
+    print(json.dumps({'t': round(time.time()), **r}), flush=True)
+
+
+def mem_avail_gb():
+    for line in open('/proc/meminfo'):
+        if line.startswith('MemAvailable:'):
+            return int(line.split()[1]) / 2 ** 20
+    return 0.0
+
+
+def procs():
+    out = subprocess.run(['ps', '-eo', 'pid=,ppid=,comm=,args='], capture_output=True, text=True).stdout
+    rows = []
+    for line in out.splitlines():
+        p = line.split(None, 3)
+        if len(p) == 4:
+            rows.append((int(p[0]), int(p[1]), p[2], p[3]))
+    return rows
+
+
+def state():
+    rows = procs()
+    lean = sum(1 for _, _, c, _ in rows if c == 'lean')
+    rep = {pid for pid, _, _, a in rows if 'cert233.py replay' in a}
+    # the pool children of a replay with --seed-jobs > 1 carry the same command line: count top-level ones
+    replays = [(pid, a) for pid, pp, _, a in rows if pid in rep and pp not in rep]
+    kids = {}
+    for pid, pp, _, _ in rows:
+        kids.setdefault(pp, []).append(pid)
+    comm = {pid: c for pid, _, c, _ in rows}
+
+    def cadicals(pid):
+        return sum((comm.get(k) == 'cadical') + cadicals(k) for k in kids.get(pid, []))
+    # a replay with --seed-jobs > 1 runs several cadical processes: count each as a core
+    cores = sum(max(1, cadicals(pid)) for pid, _ in replays)
+    workers = {}
+    for pid, _, _, a in rows:
+        m = re.search(r'pregen233\.py --worker (\d+)', a)
+        if m and 'python' in a.split()[0]:
+            workers[int(m.group(1))] = pid
+    return lean, replays, workers, rows, cores
+
+
+def kill_tree(pid, rows):
+    for c, pp, _, _ in rows:
+        if pp == pid:
+            kill_tree(c, rows)
+    try:
+        os.kill(pid, signal.SIGTERM)
+    except ProcessLookupError:
+        pass
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--cores', type=int, default=4)
+    ap.add_argument('--over', type=int, default=1, help='tolerated oversubscription before retiring')
+    ap.add_argument('--min-workers', type=int, default=2)
+    ap.add_argument('--max-workers', type=int, default=6)
+    ap.add_argument('--start-mem-gb', type=float, default=4.0)
+    ap.add_argument('--kill-mem-gb', type=float, default=1.2)
+    ap.add_argument('--min-disk-mb', type=int, default=2300)
+    ap.add_argument('--start-gap', type=int, default=180)
+    ap.add_argument('--interval', type=int, default=60)
+    ap.add_argument('--seed-jobs', default='auto', help='for the workers it starts')
+    a = ap.parse_args()
+    last_start = 0.0
+    last_note = None
+    legacy = set(state()[2].values())
+    next_main = 0.0
+    while True:
+        try:
+            while os.waitpid(-1, os.WNOHANG)[0]:
+                pass
+        except ChildProcessError:
+            pass
+        lean, replays, workers, rows, gen_cores = state()
+        legacy &= set(workers.values())
+        for pid in list(legacy):
+            if not any(pp == pid for _, pp, _, _ in rows):
+                i = [k for k, v in workers.items() if v == pid][0]
+                os.kill(pid, signal.SIGTERM)
+                legacy.discard(pid)
+                log(action='stop-legacy', worker=i, pid=pid)
+        if time.time() < next_main:
+            time.sleep(5 if legacy else 1)
+            continue
+        next_main = time.time() + a.interval
+        busy = lean + gen_cores
+        mem = mem_avail_gb()
+        disk = shutil.disk_usage('/').free // 2 ** 20
+        pending = [i for i in workers if os.path.exists(os.path.join(BASE, 'pregen_stop%d' % i))]
+        note = dict(lean=lean, replays=len(replays), gen_cores=gen_cores, workers=sorted(workers), mem_gb=round(mem, 1), disk_mb=disk)
+        if mem < a.kill_mem_gb and len(workers) > a.min_workers:
+            i = max(workers)
+            mine = [(pid, ar) for pid, ar in replays if 'pregen%d/out' % i in ar]
+            kill_tree(workers[i], rows)
+            for pid, ar in mine:
+                kill_tree(pid, rows)
+                n = ar.split()[-1]
+                for f in (os.path.join(BASE, 'pregen_claims', n),
+                          os.path.join(BASE, 'pregen%d' % i, 'out', 'LocalWindowUnsat', n + '.lean')):
+                    if os.path.exists(f):
+                        os.remove(f)
+            log(action='kill', worker=i, reason='memory', **note)
+        elif (busy > a.cores + a.over and len(workers) - len(pending) > a.min_workers and not pending
+              and [k for k, v in workers.items() if v not in legacy]):
+            i = max(k for k, v in workers.items() if v not in legacy)
+            open(os.path.join(BASE, 'pregen_stop%d' % i), 'w').close()
+            log(action='retire', worker=i, **note)
+        elif (busy < a.cores and len(workers) < a.max_workers and mem >= a.start_mem_gb
+              and disk >= a.min_disk_mb + 500 and time.time() - last_start >= a.start_gap):
+            i = min(set(range(a.max_workers)) - set(workers))
+            stop = os.path.join(BASE, 'pregen_stop%d' % i)
+            if os.path.exists(stop):
+                os.remove(stop)
+            env = dict(os.environ, CERT233_SCR=BASE, PATH=LEANBIN + ':' + os.environ.get('PATH', ''))
+            with open(os.path.join(BASE, 'logs', 'pregen%d.log' % i), 'a') as lf:
+                subprocess.Popen(['nice', '-n', '12', sys.executable, os.path.join(HERE, 'pregen233.py'),
+                                  '--worker', str(i), '--min-disk-mb', str(a.min_disk_mb), '--seed-jobs', a.seed_jobs],
