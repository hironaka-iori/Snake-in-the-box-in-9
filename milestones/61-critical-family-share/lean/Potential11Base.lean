    decide ((cycle.getD i (0,0,0)).2.1=(cycle.getD ((i+1)%cycle.length) (0,0,0)).1))=true := by decide +kernel
theorem attainment : 20*(cycle.map (fun e => e.2.2)).sum=9891*cycle.length := by decide +kernel
