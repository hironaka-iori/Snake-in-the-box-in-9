__pycache__/
build/
certificates/*.cnf
certificates/*.drat
certificates/*.lrat

# Retain completed Lean replays; other exports remain reproducible local intermediates.
/lean/LocalWindowCnf/*
!/lean/LocalWindowCnf/FourRun0.lean
!/lean/LocalWindowCnf/FourRun1.lean
!/lean/LocalWindowCnf/FourRun14.lean
!/lean/LocalWindowCnf/FourRun22.lean
/lean/LocalWindowSat/*
!/lean/LocalWindowSat/FourRun0.lean
!/lean/LocalWindowSat/FourRun1.lean
!/lean/LocalWindowSat/FourRun14.lean
!/lean/LocalWindowSat/FourRun22.lean
/lean/LocalWindowUnsat/*
!/lean/LocalWindowUnsat/FourRun0.lean
!/lean/LocalWindowUnsat/FourRun0/
!/lean/LocalWindowUnsat/FourRun1.lean
!/lean/LocalWindowUnsat/FourRun1/
!/lean/LocalWindowUnsat/FourRun14.lean
!/lean/LocalWindowUnsat/FourRun14/
!/lean/LocalWindowUnsat/FourRun22.lean
!/lean/LocalWindowUnsat/FourRun22/
/lean/RunWindow*.lean
/data/four*.json
!/lean/RunWindow0.lean
!/data/four0.json
!/lean/RunWindow1.lean
!/data/four1.json
!/lean/RunWindow14.lean
!/data/four14.json
!/lean/RunWindow22.lean
!/data/four22.json
