    (h4 : (35)*x0 + (35)*x1 + (8)*x2 + (8)*x3 + (128)*x4 = 315*s4)
    : x0 = 0 ∧ x1 = 0 ∧ x2 = 0 ∧ x3 = 0 ∧ x4 = 0 := by
