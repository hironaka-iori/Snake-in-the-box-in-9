  have e3 := row_3 x0 x1 x2 x3 x4
  rw [h0,h1,h2,h3,h4] at e3
  have e4 := row_4 x0 x1 x2 x3 x4
  rw [h0,h1,h2,h3,h4] at e4
  have z := admissible s0 (ternary_mem s0 hs0) s1 (ternary_mem s1 hs1) s2 (ternary_mem s2 hs2) s3 (ternary_mem s3 hs3) s4 (ternary_mem s4 hs4)
    ⟨x0, e0.symm⟩ ⟨x1, e1.symm⟩ ⟨x2, e2.symm⟩ ⟨x3, e3.symm⟩ ⟨x4, e4.symm⟩
  rcases z with ⟨rfl,rfl,rfl,rfl,rfl⟩
  clear h0 h1 h2 h3 h4
