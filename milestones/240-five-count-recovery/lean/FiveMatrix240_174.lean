    (hs1 : -1 ≤ s1 ∧ s1 ≤ 1)
    (hs2 : -1 ≤ s2 ∧ s2 ≤ 1)
    (hs3 : -1 ≤ s3 ∧ s3 ≤ 1)
    (hs4 : -1 ≤ s4 ∧ s4 ≤ 1)
    (h0 : (128)*x0 + (-16)*x1 + (8)*x2 + (8)*x3 + (8)*x4 = 315*s0)
    (h1 : (-16)*x0 + (128)*x1 + (8)*x2 + (-10)*x3 + (-10)*x4 = 315*s1)
    (h2 : (8)*x0 + (8)*x1 + (128)*x2 + (-10)*x3 + (35)*x4 = 315*s2)
    (h3 : (8)*x0 + (-10)*x1 + (-10)*x2 + (128)*x3 + (-16)*x4 = 315*s3)
    (h4 : (8)*x0 + (-10)*x1 + (35)*x2 + (-16)*x3 + (128)*x4 = 315*s4)
    : x0 = 0 ∧ x1 = 0 ∧ x2 = 0 ∧ x3 = 0 ∧ x4 = 0 := by
  have e0 := row_0 x0 x1 x2 x3 x4
  rw [h0,h1,h2,h3,h4] at e0
  have e1 := row_1 x0 x1 x2 x3 x4
  rw [h0,h1,h2,h3,h4] at e1
