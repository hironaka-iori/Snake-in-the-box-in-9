    ∀ s1 ∈ ([-1,0,1] : List Int),
    ∀ s2 ∈ ([-1,0,1] : List Int),
    ∀ s3 ∈ ([-1,0,1] : List Int),
    ∀ s4 ∈ ([-1,0,1] : List Int),
    (26824976064 ∣ ((241972164)*(315*s0) + (49074660)*(315*s1) + (22753548)*(315*s2) + (22565520)*(315*s3) + (-79215840)*(315*s4))) →
