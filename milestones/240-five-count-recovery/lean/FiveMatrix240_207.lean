    (hs1 : -1 ≤ s1 ∧ s1 ≤ 1)
    (hs2 : -1 ≤ s2 ∧ s2 ≤ 1)
    (hs3 : -1 ≤ s3 ∧ s3 ≤ 1)
    (hs4 : -1 ≤ s4 ∧ s4 ≤ 1)
    (h0 : (128)*x0 + (-16)*x1 + (8)*x2 + (8)*x3 + (-10)*x4 = 315*s0)
    (h1 : (-16)*x0 + (128)*x1 + (8)*x2 + (-10)*x3 + (-10)*x4 = 315*s1)
    (h2 : (8)*x0 + (8)*x1 + (128)*x2 + (35)*x3 + (8)*x4 = 315*s2)
