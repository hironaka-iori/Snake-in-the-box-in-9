theorem counterClause217 (q : Nat → Bool) : valuationOf q 114 = false ∨ valuationOf q 223 = true := by
  have hs : count223 q = (countLit q [113]) + (countLit q [114]) := List.countP_append (p := literal q) (l₁ := [113]) (l₂ := [114])
  have hm := merge_right (literal (valuationOf q) (114)) (literal (valuationOf q) (223)) (countLit q [113]) (countLit q [114]) (count223 q) 1 (meaning114 q) (meaning223 q) hs
  change valuationOf q 114 = false ∨ valuationOf q 223 = true at hm
  simpa only [Bool.not_eq_false] using hm

