theorem counterClause478 (q : Nat → Bool) : valuationOf q 113 = false ∨ valuationOf q 223 = true := by
  have hs : count223 q = (countLit q [113]) + (countLit q [114]) := List.countP_append (p := literal q) (l₁ := [113]) (l₂ := [114])
  have hm := merge_left (literal (valuationOf q) (113)) (literal (valuationOf q) (223)) (countLit q [113]) (countLit q [114]) (count223 q) 1 (meaning113 q) (meaning223 q) hs
  change valuationOf q 113 = false ∨ valuationOf q 223 = true at hm
  simpa only [Bool.not_eq_false] using hm

theorem clause478 (q : Snake 81) (h : Conditions q) : valuation q 113 = false ∨ valuation q 223 = true := counterClause478 (baseVal q)

