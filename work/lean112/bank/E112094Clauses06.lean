theorem counterClause212 (q : Nat → Bool) : valuationOf q 108 = false ∨ valuationOf q 215 = true := by
  have hs : count215 q = (countLit q [108]) + (countLit q [109, 110]) := List.countP_append (p := literal q) (l₁ := [108]) (l₂ := [109, 110])
