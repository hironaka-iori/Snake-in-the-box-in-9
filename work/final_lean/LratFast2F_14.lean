import LratFast2_14

/-! Variant of `LratFast2F` with 14-bit words (clause keys up to 16383), generated by
`milestones/10-window-aggregate/scripts/gen_checker_variants.py`. -/


/-!
# `check2` with the lemma tree forced at every step

`LratFast2.check2` passes the tree `D` of the segment's lemmas on unevaluated; it is only
evaluated when a hint is looked up in it.  Most hints go to the start database, so in a
segment with thousands of short lemmas the chain of pending insertions can grow beyond
the kernel's recursion depth and the evaluation gets stuck (observed at 3684 pending
insertions).  `check2f` forces `D` after every insertion, as `replay` does.  It is
equal to `check2` (`check2f_eq`), so the soundness theorems carry over.
-/

namespace Snake9.LratFast2F_14

open Snake9.Lrat (Tree TreeTrue andB)
open Snake9.LratFast14 (ins replay perf cpOk hasEmpty)
open Snake9.LratFast2_14 (rup2 check2 cpZ)

noncomputable section

/-- `b`, after evaluating `t` to a constructor. -/
def seqB (t : Tree) (b : Bool) : Bool := Tree.rec (motive := fun _ => Bool) b (fun _ _ _ _ _ _ => b) t

def check2f (S : Tree) : Tree → List Nat → Bool := fun D ps =>
  List.rec (motive := fun _ => Tree → Bool) (fun _ => true)
    (fun x _ ih D => andB (rup2 S D x) (let D' := ins D x; seqB D' (ih D'))) ps D

end

theorem seqB_eq (t : Tree) (b : Bool) : seqB t b = b := by cases t <;> rfl

theorem check2f_eq (S : Tree) : ∀ (ps : List Nat) (D : Tree), check2f S D ps = check2 S D ps
  | [], _ => rfl
  | x :: xs, D => by
    show andB (rup2 S D x) (seqB (ins D x) (check2f S (ins D x) xs))
      = andB (rup2 S D x) (check2 S (ins D x) xs)
    rw [seqB_eq, check2f_eq S xs]

theorem replay_true2f (τ : Nat → Bool) {t : Tree} {ps : List Nat} {h : Nat}
    (hc : check2f t (perf h 0) ps = true) (ht : TreeTrue τ t) : TreeTrue τ (replay t ps) :=
  Snake9.LratFast2_14.replay_true2 τ (by rw [← check2f_eq]; exact hc) ht

theorem cpz_true2f (τ : Nat → Bool) {s : Tree} {ps : List Nat} {t : Tree} {h : Nat}
    (hc : andB (check2f s (perf h 0) ps) (cpZ (replay s ps) t) = true) (hs : TreeTrue τ s) :
    TreeTrue τ t :=
  Snake9.LratFast2_14.cpz_true2 τ (by rw [← check2f_eq]; exact hc) hs

theorem final_false2f (τ : Nat → Bool) {s : Tree} {ps : List Nat} {k h : Nat}
    (hc : andB (check2f s (perf h 0) ps) (hasEmpty (replay s ps) k) = true) (hs : TreeTrue τ s) :
    False :=
  Snake9.LratFast2_14.final_false2 τ (by rw [← check2f_eq]; exact hc) hs

end Snake9.LratFast2F_14
