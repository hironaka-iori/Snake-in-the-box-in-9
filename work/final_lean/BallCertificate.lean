private theorem step568 (p : Nat → Bool)
    (h1 : p 1 = true)
    (h2 : p 1 = false ∨ p 2 = false ∨ p 3 = false ∨ p 5 = false)
    : p 2 = false ∨ p 3 = false ∨ p 5 = false := by
  apply Classical.byContradiction
  intro hc
  simp only [not_or, Bool.not_eq_true, Bool.not_eq_false] at hc
  rcases hc with ⟨u0, u1, u2⟩
  have t0 : p 1 = true := by
    simpa only [Bool.false_eq_true, Bool.true_eq_false, false_or, or_false] using h1
  simpa only [t0, u0, u1, u2, Bool.false_eq_true, Bool.true_eq_false, false_or, or_false] using h2

