import LocalWindowTagsShare
import LocalWindowTagsPacked
import LocalWindowTagsSharePacked
import LocalWindowShareToy.Cnf

/-! Every clause of the toy share CNF follows from the share axioms (generated by
`milestones/11-local-ceiling/s0_radius4/gen_share_toy.py`).  `meaning` (window
variables, `mtB`), `smeaning` (share variables, `mtB64`) and `tags` (`tagsOfS`) are
packed literals decoded in the kernel; `check` runs `checkAllS` once. -/

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace Snake9.LocalWindow.ShareToy

open Snake9.LocalWindow Snake9.LocalWindow.Tags

noncomputable def meaning : MT := (mtB 24 64 0 1 (nat_lit 0x41500000000000000000000001d00000000005500000000000000000000000d000000000115000000000000000000000015000000000035000000000000000000000001000000000215000000000000000000000011000000000031000000000000000000000005000000000095000000000000000000000009000000000000000000000019000000000000000000000000)).1

noncomputable def smeaning : MS := (mtB64 24 64 0 1 (nat_lit )).1

def ctrs : List Ctr := []

noncomputable def tots : List Tot :=
  [⟨natsOf 2 (nat_lit 0x22000020), .emp 5⟩,
   ⟨natsOf 9 (nat_lit 0x1e00001c00001a00001800001600001200000400000e00000c), .nb 5⟩,
   ⟨natsOf 1 (nat_lit 0x2e), .cap [[(2, 1)], []]⟩]

noncomputable def tags : List TagS := tagsOfS 16 (nat_lit 0x5000000000004d00002000000f00002000000f00000000002e00000000002e00000000000d00000000000d00000000000d00000000000c00000000000c000000000006000000000000000000000000000000000000000000000000)

theorem check : checkAllS meaning smeaning resolution ctrs tots window bounds cap tags raw = true := by
  decide +kernel

theorem sat : ∀ S E : Nat → Bool,
    AxiomsS S E window (centresOf window bounds) resolution cap → ∃ τ, cnfTrue τ cnf = true :=
  fun S E h => ⟨tauS S E meaning smeaning resolution ctrs tots,
    soundS meaning smeaning resolution ctrs tots window bounds cap tags raw check S E h⟩

end Snake9.LocalWindow.ShareToy
