/-- Every restricted growth string of length 8 passing the xor-mask induced test has its code among
the codes of `shapesK7R34C7W16` (kernel checks split at prefix length 5). -/
theorem shareCoverK7R34C7W16 (c : List Nat) (hc : c.length = 8) (hr : isRGS c 0 = true) :
    (!inducedFast c || (shapesK7R34C7W16.map shapeCode).any (Nat.beq (shapeCode c))) = true :=
  allRGS_of_prefixes shareRgsPK7R34C7W16 5 3 shareRgsPreK7R34C7W16 shareRgsPreK7R34C7W16_ok shareRgsPreK7R34C7W16_cov
    shareRgsK7R34C7W16_pres (by decide) c (by rw [hc]) hr

theorem window_shape_memK7R34C7W16 {m : Nat} (p : Snake m) (j : Nat) (hj : j + 8 ≤ m) :
    canon (windowDirsK7R34C7W16 p j) ∈ shapesK7R34C7W16 := by
  rw [windowDirsK7R34C7W16_eq]
  exact window_shape_mem_of shapesK7R34C7W16 8 (by decide) shapesK7R34C7W16_ok shareCoverK7R34C7W16 p j hj

/-! ## 3. The conditional 230 -/

/-- Conditional 230, plain form of the share premise: every window `j` (1 ≤ j, j + 8 ≤ m) has share
sum at least 27. -/
theorem upper_230_of_direction_windows_and_shares_allK7R34C7W16 {m : Nat} (p : Snake m)
    (hw2 : ∀ j, j + 3 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2))] = false)
    (hw3 : ∀ j, j + 4 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3))] = false)
    (hw4 : ∀ j, j + 5 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4))] = false)
    (hw5 : ∀ j, j + 6 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5))] = false)
    (hw6 : ∀ j, j + 7 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5)), symK 8 (countSeq p (j+6))] = false)
    (hw7 : ∀ j, j + 8 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6), pathDir p (j+7)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5)), symK 8 (countSeq p (j+6)), symK 8 (countSeq p (j+7))] = false)
    (hshare : ∀ j, 1 ≤ j → j + 8 ≤ m → 27 ≤ windowShareK7R34C7W16 p j) : m ≤ 230 := by
  by_cases hm : m < 8
  · omega
  have hwalk := walkK7R34C7W16 p (by omega) hw2 hw3 hw4 hw5 hw6 hw7
  exact upper_of_walk_and_shares p 89 19 678 8 7 27 230 (by omega) (by decide) (by omega) hwalk
    (fun j h1 h2 => by rw [← windowShareK7R34C7W16_eq]; exact hshare j (by omega) (by omega)) (by decide)

/-- **Conditional 230-edge bound.**  Premises: the window exclusions of the K7R34C7W16 chain
(`hw2` .. `hw7`, unchanged) and, for each of the 132 7-centre direction shapes of the chain, that no
window of that shape has share sum at most 26.  Neither premise is proved in Lean. -/
theorem upper_230_of_direction_windows_and_sharesK7R34C7W16 {m : Nat} (p : Snake m)
    (hw2 : ∀ j, j + 3 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2))] = false)
    (hw3 : ∀ j, j + 4 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3))] = false)
    (hw4 : ∀ j, j + 5 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4))] = false)
    (hw5 : ∀ j, j + 6 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5))] = false)
    (hw6 : ∀ j, j + 7 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5)), symK 8 (countSeq p (j+6))] = false)
    (hw7 : ∀ j, j + 8 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6), pathDir p (j+7)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5)), symK 8 (countSeq p (j+6)), symK 8 (countSeq p (j+7))] = false)
    (hshare : ∀ s ∈ shapesK7R34C7W16, ∀ j, 1 ≤ j → j + 8 ≤ m →
      canon (windowDirsK7R34C7W16 p j) = s → 27 ≤ windowShareK7R34C7W16 p j) : m ≤ 230 :=
  upper_230_of_direction_windows_and_shares_allK7R34C7W16 p hw2 hw3 hw4 hw5 hw6 hw7
    (fun j h1 h2 => hshare _ (window_shape_memK7R34C7W16 p j h2) j h1 h2 rfl)

