/-! ## 1. The walk inequality of the chain -/

theorem walkK7R34C7W16 {m : Nat} (p : Snake m) (hm : 8 ≤ m)
    (hw2 : ∀ j, j + 3 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2))] = false)
    (hw3 : ∀ j, j + 4 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3))] = false)
    (hw4 : ∀ j, j + 5 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4))] = false)
    (hw5 : ∀ j, j + 6 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5))] = false)
    (hw6 : ∀ j, j + 7 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5)), symK 8 (countSeq p (j+6))] = false)
    (hw7 : ∀ j, j + 8 ≤ m → wforbK7R34C7W16 [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6), pathDir p (j+7)]
      [symK 8 (countSeq p (j+1)), symK 8 (countSeq p (j+2)), symK 8 (countSeq p (j+3)), symK 8 (countSeq p (j+4)), symK 8 (countSeq p (j+5)), symK 8 (countSeq p (j+6)), symK 8 (countSeq p (j+7))] = false) :
    89 * m ≤ 19 * psum (fun j => countSeq p (j+1)) (m-1) + 678 := by
  obtain ⟨_, _, hpos, _, _⟩ := countSeq_facts p (by omega)
  have hpos' : ∀ j, 1 ≤ j → j + 1 ≤ m → 1 ≤ countSeq p j := by
    intro j hj hjm
    have := hpos (j - 1) (by omega)
    simpa [show j - 1 + 1 = j by omega] using this
  have htot := total_boundK7R34C7W16 (pathDir p) (countSeq p) m hm hpos'
    (fun i hi => by rw [winK7R34C7W16_eq]; exact snake_inducedPattern_block p i 9 hi) hw2 hw3 hw4 hw5 hw6 hw7
  rw [sumA_eq_psum] at htot
  exact htot

/-! ## 2. Windows -/

/-- Directions of window `j`: the 8 edges from vertex `j` to vertex `j+8` (the window of `hw7 j`). -/
def windowDirsK7R34C7W16 {m : Nat} (p : Snake m) (j : Nat) : List Nat :=
  [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6), pathDir p (j+7)]

/-- Share sum over the 7 centres `j+1 .. j+7` of window `j`. -/
def windowShareK7R34C7W16 {m : Nat} (p : Snake m) (j : Nat) : Nat :=
  shareSeq p (j+1) + shareSeq p (j+2) + shareSeq p (j+3) + shareSeq p (j+4) + shareSeq p (j+5) + shareSeq p (j+6) + shareSeq p (j+7)

theorem windowDirsK7R34C7W16_eq {m : Nat} (p : Snake m) (j : Nat) : windowDirsK7R34C7W16 p j = blockList p j 8 := rfl

theorem windowShareK7R34C7W16_eq {m : Nat} (p : Snake m) (j : Nat) : windowShareK7R34C7W16 p j = windowShareK p 7 j := by
  simp only [windowShareK7R34C7W16, windowShareK, Finset.sum_range_succ, Finset.sum_range_zero, Nat.zero_add,
    Nat.add_zero, Nat.add_assoc, Nat.reduceAdd]

/-- The coverage test: not induced (xor-mask test), or the code of a listed shape. -/
def shareRgsPK7R34C7W16 (c : List Nat) : Bool := (!inducedFast c || (shapesK7R34C7W16.map shapeCode).any (Nat.beq (shapeCode c)))

