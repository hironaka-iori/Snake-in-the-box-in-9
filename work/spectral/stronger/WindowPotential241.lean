  | 7, 6, 1 => 2
  | 7, 6, 2 => 1
  | 7, 7, 1 => 2
  | 7, 7, 2 => 1
  | _, _, _ => 0

def pot3 (a b c : Nat) : Nat := potC3 (clamp a) (clamp b) (clamp c)

def step4B (a b c d : Nat) : Bool :=
  !(decide (1 ≤ a) && decide (1 ≤ b) && decide (1 ≤ c) && decide (1 ≤ d) &&
      pairB a b && pairB b c && pairB c d && !exclB a b c && !exclB b c d && !quadB a b c d)
    || decide (3 + potC3 a b c ≤ d + potC3 b c d)

def base3B (a b c : Nat) : Bool :=
  !(decide (1 ≤ a) && decide (1 ≤ b) && decide (1 ≤ c) && pairB a b && pairB b c && !exclB a b c)
    || decide (9 ≤ a + b + c + potC3 a b c)

theorem step4_table : allBelow 8 (fun a => allBelow 8 (fun b => allBelow 8 (fun c =>
    allBelow 8 (fun d => step4B a b c d)))) = true := by
  decide

theorem base3_table : allBelow 8 (fun a => allBelow 8 (fun b => allBelow 8 (fun c =>
    base3B a b c))) = true := by
  decide

theorem pot3_table : allBelow 8 (fun a => allBelow 8 (fun b => allBelow 8 (fun c =>
    decide (potC3 a b c ≤ 4)))) = true := by
  decide

theorem pot3_le (a b c : Nat) : pot3 a b c ≤ 4 := by
  have h := allBelow_spec 8 _ (allBelow_spec 8 _ (allBelow_spec 8 _ pot3_table
    (clamp a) (clamp_lt a)) (clamp b) (clamp_lt b)) (clamp c) (clamp_lt c)
  simpa [pot3] using h

theorem quad_clamp (x y z w : Nat) (h : ¬QuadExcluded x y z w) :
    quadB (clamp x) (clamp y) (clamp z) (clamp w) = false := by
  unfold quadB
  rw [decide_eq_false_iff_not]
  intro hh
  apply h
  unfold QuadExcluded
  rcases clamp_cases x with ⟨_, ex⟩ | ⟨_, ex⟩ <;>
  rcases clamp_cases y with ⟨_, ey⟩ | ⟨_, ey⟩ <;>
  rcases clamp_cases z with ⟨_, ez⟩ | ⟨_, ez⟩ <;>
  rcases clamp_cases w with ⟨_, ew⟩ | ⟨_, ew⟩ <;>
  rw [ex, ey, ez, ew] at hh <;>
  rcases hh with ⟨_, _, _, _⟩ | ⟨_, _, _, _⟩ <;>
  first
    | omega
    | exact Or.inl ⟨by omega, by omega, by omega, by omega⟩
    | exact Or.inr ⟨by omega, by omega, by omega, by omega⟩

theorem step4 (x y z w : Nat) (hx : 1 ≤ x) (hy : 1 ≤ y) (hz : 1 ≤ z) (hw : 1 ≤ w)
    (hxy : PairOK x y) (hyz : PairOK y z) (hzw : PairOK z w)
    (he1 : ¬Excluded x y z) (he2 : ¬Excluded y z w) (hq : ¬QuadExcluded x y z w) :
    3 + pot3 x y z ≤ w + pot3 y z w := by
  have hc := allBelow_spec 8 _ (allBelow_spec 8 _ (allBelow_spec 8 _ (allBelow_spec 8 _ step4_table
    (clamp x) (clamp_lt x)) (clamp y) (clamp_lt y)) (clamp z) (clamp_lt z)) (clamp w) (clamp_lt w)
  have h' : 3 + potC3 (clamp x) (clamp y) (clamp z) ≤ clamp w + potC3 (clamp y) (clamp z) (clamp w) := by
    simpa [step4B, clamp_ge_one x hx, clamp_ge_one y hy, clamp_ge_one z hz, clamp_ge_one w hw,
      pair_clamp x y hxy, pair_clamp y z hyz, pair_clamp z w hzw, excl_clamp x y z he1,
      excl_clamp y z w he2, quad_clamp x y z w hq] using hc
  have := le_clamp_mul w
  unfold pot3
  omega

theorem base3 (a b c : Nat) (ha : 1 ≤ a) (hb : 1 ≤ b) (hc : 1 ≤ c)
    (hab : PairOK a b) (hbc : PairOK b c) (he : ¬Excluded a b c) :
    9 ≤ a + b + c + pot3 a b c := by
  have ht := allBelow_spec 8 _ (allBelow_spec 8 _ (allBelow_spec 8 _ base3_table
    (clamp a) (clamp_lt a)) (clamp b) (clamp_lt b)) (clamp c) (clamp_lt c)
  have h' : 9 ≤ clamp a + clamp b + clamp c + potC3 (clamp a) (clamp b) (clamp c) := by
    simpa [base3B, clamp_ge_one a ha, clamp_ge_one b hb, clamp_ge_one c hc,
      pair_clamp a b hab, pair_clamp b c hbc, excl_clamp a b c he] using ht
  have := le_clamp_mul a
  have := le_clamp_mul b
  have := le_clamp_mul c
  unfold pot3
  omega

theorem prefix_cost3 (h : Nat → Nat) : ∀ n, 3 ≤ n →
    (∀ j, j < n → 1 ≤ h j) →
    (∀ j, j + 1 < n → PairOK (h j) (h (j + 1))) →
    (∀ j, j + 2 < n → ¬Excluded (h j) (h (j + 1)) (h (j + 2))) →
    (∀ j, j + 3 < n → ¬QuadExcluded (h j) (h (j + 1)) (h (j + 2)) (h (j + 3))) →
    3 * n ≤ psum h n + pot3 (h (n - 3)) (h (n - 2)) (h (n - 1))
  | 0, hn, _, _, _, _ => by omega
  | 1, hn, _, _, _, _ => by omega
  | 2, hn, _, _, _, _ => by omega
  | 3, _, hpos, hpair, hex, _ => by
    have := base3 (h 0) (h 1) (h 2) (hpos 0 (by omega)) (hpos 1 (by omega)) (hpos 2 (by omega))
      (hpair 0 (by omega)) (hpair 1 (by omega)) (hex 0 (by omega))
    simp only [psum, show (3 : Nat) - 3 = 0 from rfl, show (3 : Nat) - 2 = 1 from rfl,
      show (3 : Nat) - 1 = 2 from rfl]
    omega
  | k + 4, _, hpos, hpair, hex, hq => by
    have ih := prefix_cost3 h (k + 3) (by omega) (fun j hj => hpos j (by omega))
      (fun j hj => hpair j (by omega)) (fun j hj => hex j (by omega)) (fun j hj => hq j (by omega))
    have hs := step4 (h k) (h (k + 1)) (h (k + 2)) (h (k + 3)) (hpos _ (by omega)) (hpos _ (by omega))
      (hpos _ (by omega)) (hpos _ (by omega)) (hpair k (by omega)) (hpair (k + 1) (by omega))
      (hpair (k + 2) (by omega)) (hex k (by omega)) (hex (k + 1) (by omega)) (hq k (by omega))
    simp only [psum] at ih ⊢
    simp only [show k + 3 - 3 = k by omega, show k + 3 - 2 = k + 1 by omega,
      show k + 3 - 1 = k + 2 by omega] at ih
    simp only [show k + 4 - 3 = k + 1 by omega, show k + 4 - 2 = k + 2 by omega,
      show k + 4 - 1 = k + 3 by omega]
    omega

/-- Internal counts average at least 3, up to an additive 4. -/
theorem internal_cost3 (h : Nat → Nat) (n : Nat) (hn : 3 ≤ n)
    (hpos : ∀ j, j < n → 1 ≤ h j)
    (hpair : ∀ j, j + 1 < n → PairOK (h j) (h (j + 1)))
    (hex : ∀ j, j + 2 < n → ¬Excluded (h j) (h (j + 1)) (h (j + 2)))
    (hq : ∀ j, j + 3 < n → ¬QuadExcluded (h j) (h (j + 1)) (h (j + 2)) (h (j + 3))) :
    3 * n ≤ psum h n + 4 := by
  have := prefix_cost3 h n hn hpos hpair hex hq
  have := pot3_le (h (n - 3)) (h (n - 2)) (h (n - 1))
  omega

theorem edges_le_241 (m I e0 e1 E0 : Nat)
    (hI : 3 * (m - 1) ≤ I + 4) (h0 : 4 ≤ e0) (h1 : 4 ≤ e1)
    (hid : e0 + I + e1 + 2 * E0 + 35 * (m + 1) = 9214) : m ≤ 241 := by
  omega

end Snake9.WindowAggregate

#print axioms Snake9.WindowAggregate.internal_cost3
