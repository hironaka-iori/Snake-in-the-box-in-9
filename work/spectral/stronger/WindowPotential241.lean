/-
Four-window sequence potential for the conditional 241-edge bound.

Core Lean only. In addition to the triples excluded in `WindowPotential242`,
it assumes that the internal count windows (2,4,2,3) and (3,2,4,2) do not
occur. That assumption is a DRAT-certified local observation recorded in
`milestones/10-window-aggregate/`, not a Lean theorem.
-/
import WindowPotential242

namespace Snake9.WindowAggregate

def QuadExcluded (x y z w : Nat) : Prop :=
  (x = 2 ∧ y = 4 ∧ z = 2 ∧ w = 3) ∨ (x = 3 ∧ y = 2 ∧ z = 4 ∧ w = 2)

def quadB (x y z w : Nat) : Bool :=
  decide ((x = 2 ∧ y = 4 ∧ z = 2 ∧ w = 3) ∨ (x = 3 ∧ y = 2 ∧ z = 4 ∧ w = 2))

/-- Longest-path potential on clamped triples for weight 3 - w (generated by
`milestones/10-window-aggregate/scripts/aggregate.py`, which checks this table). -/
def potC3 : Nat → Nat → Nat → Nat
  | 1, 4, 1 => 3
  | 1, 4, 2 => 2
  | 1, 4, 3 => 1
  | 1, 5, 1 => 3
  | 1, 5, 2 => 2
  | 1, 5, 3 => 1
  | 1, 6, 1 => 2
  | 1, 6, 2 => 1
  | 1, 7, 1 => 2
  | 1, 7, 2 => 1
  | 2, 2, 5 => 1
  | 2, 3, 3 => 2
  | 2, 3, 4 => 1
  | 2, 4, 1 => 4
  | 2, 4, 2 => 2
  | 2, 4, 3 => 2
  | 2, 4, 4 => 1
  | 2, 5, 1 => 3
  | 2, 5, 2 => 2
  | 2, 5, 3 => 1
  | 2, 6, 1 => 2
  | 2, 6, 2 => 1
  | 2, 7, 1 => 2
  | 2, 7, 2 => 1
  | 3, 2, 4 => 2
  | 3, 2, 5 => 1
  | 3, 3, 2 => 3
  | 3, 3, 3 => 2
  | 3, 3, 4 => 1
  | 3, 4, 1 => 3
  | 3, 4, 2 => 2
  | 3, 4, 3 => 1
  | 3, 5, 1 => 2
  | 3, 5, 2 => 1
  | 3, 6, 1 => 2
  | 3, 6, 2 => 1
  | 3, 7, 1 => 2
  | 3, 7, 2 => 1
  | 4, 2, 3 => 2
  | 4, 2, 4 => 1
  | 4, 3, 2 => 3
  | 4, 3, 3 => 2
  | 4, 3, 4 => 1
  | 4, 4, 1 => 3
  | 4, 4, 2 => 2
  | 4, 4, 3 => 1
  | 4, 5, 1 => 2
  | 4, 5, 2 => 1
  | 4, 6, 1 => 2
  | 4, 6, 2 => 1
  | 4, 7, 1 => 2
  | 4, 7, 2 => 1
  | 5, 1, 5 => 1
  | 5, 2, 2 => 3
  | 5, 2, 3 => 2
  | 5, 2, 4 => 1
  | 5, 3, 2 => 2
  | 5, 3, 3 => 1
  | 5, 4, 1 => 2
  | 5, 4, 2 => 1
  | 5, 5, 1 => 2
  | 5, 5, 2 => 1
  | 5, 6, 1 => 2
  | 5, 6, 2 => 1
  | 5, 7, 1 => 2
  | 5, 7, 2 => 1
  | 6, 2, 2 => 2
  | 6, 2, 3 => 1
  | 6, 3, 2 => 1
  | 6, 4, 1 => 2
  | 6, 4, 2 => 1
