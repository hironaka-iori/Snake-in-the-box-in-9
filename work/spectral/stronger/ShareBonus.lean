import EmptyShareBound
import AggregateDirectionConditional
import WindowAutomatonCode

/-!
# Chain-independent empty-square share bonus

Ingredients shared by every `AggregateDirection<suffix>Share<N>` wrapper.

A window-automaton chain with `L` directions of memory and `k` centres (generated by
`gen_lean_swar.py --start`) proves

    P m ≤ Q Σ_{j=1}^{m-1} α_j + C,      C = P L - Q (L - k) + D            (`total_bound<suffix>`)

by telescoping its potential over the steps `i = 0 .. m-L-1`.  Step `i` uses the `k`-centre premise
`hw<k> (i + L - k)`, i.e. the window `j = i + L - k` with directions `j .. j+k` and centres
`j+1 .. j+k`.  So the steps cover exactly the `m - L` windows `j = L-k .. m-k-1`
(K6, L = 7: `j = 1 .. m-7`; K7, L = 8: `j = 1 .. m-8`).

* `windowShareK p k j` is the share sum over the centres `j+1 .. j+k`.
* `sum_windowShareK_le`: the windows `j = t .. t+n-1` with `t + n + k ≤ m + 1` have total share at most
  `k · totalShare p` (a vertex is a centre of at most `k` of them).
* `window_shape_mem_of`: a coverage fact about restricted growth strings (kernel-checked in the
  wrapper, by `allRGS_spec` or, split by prefixes, `allRGS_of_prefixes`) turns a per-shape premise
  into a premise for every window.  Coverage is a list search over the shape codes: a bitset
  indexed by codes of 8-direction strings is a 2^27-bit number, too large to shift once per
  string in the kernel.
* `share_arith` / `upper_of_walk_and_shares`: the walk inequality, a uniform lower bound `LB` on the
  window shares and `weighted_identity_bound` give `m ≤ N` as soon as

    193494 k Q + 21 k C + Q LB L < (21 k P + Q LB + 735 k Q) (N + 1) + 903 k Q.

  (`903 = 168 + 735`: the endpoints carry `α ≥ 4` each, and `v = m + 1`.)
-/

namespace Snake9.ShareBonus
open SquareIncidence Finset Classical WindowAggregate WindowAutomaton
noncomputable section
set_option maxHeartbeats 1600000

/-! ## Window shares for `k` centres -/

/-- `share` of the c-th path vertex, padded by zero (like `countSeq`). -/
def shareSeq {m : Nat} (p : Snake m) (c : Nat) : Nat :=
  if hc : c < m + 1 then share p ⟨c, hc⟩ else 0

/-- Share sum over the `k` centres `j+1 .. j+k` of window `j`. -/
def windowShareK {m : Nat} (p : Snake m) (k j : Nat) : Nat :=
  ∑ c ∈ Finset.range k, shareSeq p (j + 1 + c)

theorem totalShare_eq_range {m : Nat} (p : Snake m) :
    totalShare p = ∑ c ∈ Finset.range (m + 1), shareSeq p c := by
  unfold totalShare
  rw [Finset.sum_range (fun c => shareSeq p c)]
  apply Finset.sum_congr rfl
  intro i _
  simp [shareSeq, i.isLt]

theorem shift_sum_le (f : Nat → Nat) (n t N : Nat) (h : t + n ≤ N) :
    ∑ j ∈ Finset.range n, f (j + t) ≤ ∑ c ∈ Finset.range N, f c := by
  calc ∑ j ∈ Finset.range n, f (j + t)
      = ∑ j ∈ Finset.range n, f (t + j) := by
        apply Finset.sum_congr rfl; intro j _; rw [Nat.add_comm]
    _ ≤ ∑ c ∈ Finset.range t, f c + ∑ j ∈ Finset.range n, f (t + j) := Nat.le_add_left _ _
    _ = ∑ c ∈ Finset.range (t + n), f c := (Finset.sum_range_add f t n).symm
    _ ≤ ∑ c ∈ Finset.range N, f c :=
        Finset.sum_le_sum_of_subset (Finset.range_subset.mpr h)

/-- Multiplicity: the windows `j = t .. t+n-1` (centres up to `t+n+k-1 ≤ m`) have total share at
most `k` times the total share of the path. -/
theorem sum_windowShareK_le {m : Nat} (p : Snake m) (k t n : Nat) (h : t + n + k ≤ m + 1) :
    ∑ i ∈ Finset.range n, windowShareK p k (i + t) ≤ k * totalShare p := by
  unfold windowShareK
  rw [Finset.sum_comm, totalShare_eq_range]
  calc ∑ c ∈ Finset.range k, ∑ i ∈ Finset.range n, shareSeq p (i + t + 1 + c)
      ≤ ∑ _c ∈ Finset.range k, ∑ x ∈ Finset.range (m + 1), shareSeq p x := by
        apply Finset.sum_le_sum
        intro c hc
        have hc' := Finset.mem_range.mp hc
        have hs := shift_sum_le (shareSeq p) n (t + 1 + c) (m + 1) (by omega)
        calc ∑ i ∈ Finset.range n, shareSeq p (i + t + 1 + c)
            = ∑ i ∈ Finset.range n, shareSeq p (i + (t + 1 + c)) := by
              apply Finset.sum_congr rfl; intro i _; congr 1; omega
          _ ≤ _ := hs
    _ = k * ∑ x ∈ Finset.range (m + 1), shareSeq p x := by
        rw [Finset.sum_const, Finset.card_range, smul_eq_mul]

/-- The chain's windows `j = L-k .. m-k-1` (one per telescoping step). -/
theorem sum_chain_windows_le {m : Nat} (p : Snake m) (L k : Nat) (hkL : k ≤ L) (hLm : L ≤ m) :
    ∑ i ∈ Finset.range (m - L), windowShareK p k (i + (L - k)) ≤ k * totalShare p :=
  sum_windowShareK_le p k (L - k) (m - L) (by omega)

/-! ## Every window has a listed shape -/

/-- Per-shape premises become a premise on every window: if every restricted growth string of
length `n` passing the xor-mask induced test has its code among the codes of `sh`, every window of
`n` directions of a snake has its canonical shape in `sh`. -/
theorem window_shape_mem_of (sh : List (List Nat)) (n : Nat) (hn : n ≤ 8)
    (hok : sh.all (fun s => s.length == n && s.all (· < 8)) = true)
    (hcov : ∀ c, c.length = n → isRGS c 0 = true →
      (!inducedFast c || (sh.map shapeCode).any (Nat.beq (shapeCode c))) = true)
    {m : Nat} (p : Snake m) (j : Nat) (hj : j + n ≤ m) :
    canon (blockList p j n) ∈ sh := by
  have hlen : (canon (blockList p j n)).length = n := by
    rw [length_canon]; simp [blockList]
  have hr := canon_isRGS (blockList p j n)
  have hm := hcov _ hlen hr
  have hind : inducedPattern (canon (blockList p j n)) = true := by
    rw [inducedPattern_canon]; exact snake_inducedPattern_block p j n hj
  have hb : ∀ a, a ∈ canon (blockList p j n) → a < 8 := fun a ha => by
    have := isRGS_bound _ 0 hr a ha; rw [hlen] at this; omega
  have hfast := inducedFast_of_inducedPattern _ (fun d hd => by have := hb d hd; omega) hind
  rw [hfast] at hm
  simp only [Bool.not_true, Bool.false_or] at hm
  obtain ⟨x, hx, hxe⟩ := List.any_eq_true.mp hm
  obtain ⟨s, hs, hsx⟩ := List.mem_map.mp hx
  have hcode : shapeCode s = shapeCode (canon (blockList p j n)) := by
    rw [hsx]; exact (Nat.eq_of_beq_eq_true hxe).symm
  have hsh : s.length = n ∧ ∀ a, a ∈ s → a < 8 := by
    simp only [List.all_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hok
    exact hok s hs
  unfold shapeCode at hcode
  rw [codeFrom_inj _ s 1 (by rw [hlen, hsh.1]) hb hsh.2 hcode.symm]
  exact hs

/-! ## The final arithmetic -/

theorem totalAlpha_split {m : Nat} (p : Snake m) (hm : 1 ≤ m) :
    (∑ i, localAlpha p i) = countSeq p 0 + psum (fun j => countSeq p (j+1)) (m-1) + countSeq p m := by
  rw [Finset.sum_fin_eq_sum_range]
  have hc : (∑ j ∈ Finset.range (m+1), if h : j < m + 1 then localAlpha p ⟨j, h⟩ else 0) =
      ∑ j ∈ Finset.range (m+1), countSeq p j := by
    apply Finset.sum_congr rfl; intro j _; rfl
  rw [hc, psum_eq_sum, Finset.sum_range_succ]
  have he : Finset.range m = Finset.range ((m-1)+1) := by congr 1; omega
  rw [he, Finset.sum_range_succ']
  omega

/-- Pure arithmetic: walk inequality `P m ≤ Q A + C`, share bound `LB (m - L) ≤ k S` and the
weighted identity `21 (A + 8) + S + 735 (m+1) ≤ 193494` give `m ≤ N` under the numeric
certificate `hcert`. -/
theorem share_arith (P Q C L k LB N m A S : Nat) (hL : L ≤ m)
    (hw : P * m ≤ Q * A + C) (hs : LB * (m - L) ≤ k * S)
    (hid : 21 * (A + 8) + S + 735 * (m + 1) ≤ 193494)
    (hcert : 193494 * k * Q + 21 * k * C + Q * LB * L <
      (21 * k * P + Q * LB + 735 * k * Q) * (N + 1) + 903 * k * Q) : m ≤ N := by
  by_contra hN
  have hN' : N + 1 ≤ m := by omega
  obtain ⟨r, rfl⟩ : ∃ r, m = L + r := ⟨m - L, by omega⟩
  rw [show L + r - L = r by omega] at hs
  have h1 := Nat.mul_le_mul_left (21 * k) hw
  have h2 := Nat.mul_le_mul_left Q hs
  have h3 := Nat.mul_le_mul_left (k * Q) hid
  have h4 := Nat.mul_le_mul_left (21 * k * P + Q * LB + 735 * k * Q) hN'
  zify at h1 h2 h3 h4 hcert
  linarith

/-- **Generic share-bonus bound.**  A chain walk inequality `P m ≤ Q Σ_{j=1}^{m-1} α_j + C`
(the form of `total_bound<suffix>`, via `sumA_eq_psum`) and a share lower bound `LB` on each of the
chain's `m - L` windows `j = L-k .. m-k-1` give `m ≤ N` under the numeric certificate `hcert`. -/
theorem upper_of_walk_and_shares {m : Nat} (p : Snake m) (P Q C L k LB N : Nat)
    (hm3 : 3 ≤ m) (hkL : k ≤ L) (hLm : L ≤ m)
    (hwalk : P * m ≤ Q * psum (fun j => countSeq p (j+1)) (m-1) + C)
    (hshare : ∀ j, L - k ≤ j → j + k + 1 ≤ m → LB ≤ windowShareK p k j)
    (hcert : 193494 * k * Q + 21 * k * C + Q * LB * L <
      (21 * k * P + Q * LB + 735 * k * Q) * (N + 1) + 903 * k * Q) : m ≤ N := by
  obtain ⟨h0, h1, _, _, _⟩ := countSeq_facts p hm3
  have hsplit := totalAlpha_split p (by omega)
  have hwt := weighted_identity_bound p (by omega)
  have hmul := sum_chain_windows_le p L k hkL hLm
  have hlow : LB * (m - L) ≤ ∑ i ∈ Finset.range (m - L), windowShareK p k (i + (L - k)) := by
    have := Finset.sum_le_sum (s := Finset.range (m - L)) (f := fun _ => LB)
      (g := fun i => windowShareK p k (i + (L - k))) (fun i hi => hshare (i + (L - k)) (by omega)
        (by have := Finset.mem_range.mp hi; omega))
    simpa [Nat.mul_comm] using this
  rw [hsplit] at hwt
  apply share_arith P Q C L k LB N m (psum (fun j => countSeq p (j+1)) (m-1)) (totalShare p) hLm hwalk
    (le_trans hlow hmul) (by omega) hcert

#print axioms sum_windowShareK_le
#print axioms window_shape_mem_of
#print axioms share_arith
#print axioms upper_of_walk_and_shares
end
end Snake9.ShareBonus
