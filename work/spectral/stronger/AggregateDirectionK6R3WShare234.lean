import AggregateDirectionK6R3WConditional
import ShareBonus

/-!
# Conditional 234: the K6R3W chain plus a uniform empty-square share bonus

Generated by gen_share_wrapper.py.  Chain: L = 7 directions of memory, k = 6 centres, mean 4/1,
start constant D = 1; `total_boundK6R3W` reads, for a snake,

    4 m ≤ 1 Σ_{j=1}^{m-1} α_j + 28          (`walkK6R3W`, C = P L - Q (L - k) + D).

Its telescoped steps i = 0 .. m-8 use the 6-centre windows j = i + 1 (directions j .. j+6, centres
j+1 .. j+6): the m - 7 windows j = 1 .. m-7.  Share premise: for each of the 34 shapes of
`shapesK6R3W`, every such window of that shape has share sum (`windowShareK6R3W`, weights 6/3/2) at least
21.  A vertex is a centre of at most 6 windows (`ShareBonus.sum_windowShareK_le`), and
`weighted_identity_bound` closes the count (`ShareBonus.upper_of_walk_and_shares`):

    4935 m ≤ 1159221,  i.e. m ≤ 234 (234.90).
-/

namespace Snake9
open SquareIncidence Finset Classical WindowAggregate WindowAutomaton ShareBonus
noncomputable section
set_option maxHeartbeats 1600000

/-! ## 1. The walk inequality of the chain -/

theorem walkK6R3W {m : Nat} (p : Snake m) (hm : 7 ≤ m)
    (hw2 : ∀ j, j + 3 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2))] = false)
    (hw3 : ∀ j, j + 4 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3))] = false)
    (hw4 : ∀ j, j + 5 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4))] = false)
    (hw5 : ∀ j, j + 6 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4)), sym (countSeq p (j+5))] = false)
    (hw6 : ∀ j, j + 7 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4)), sym (countSeq p (j+5)), sym (countSeq p (j+6))] = false) :
    4 * m ≤ 1 * psum (fun j => countSeq p (j+1)) (m-1) + 28 := by
  obtain ⟨_, _, hpos, _, _⟩ := countSeq_facts p (by omega)
  have hpos' : ∀ j, 1 ≤ j → j + 1 ≤ m → 1 ≤ countSeq p j := by
    intro j hj hjm
    have := hpos (j - 1) (by omega)
    simpa [show j - 1 + 1 = j by omega] using this
  have htot := total_boundK6R3W (pathDir p) (countSeq p) m hm hpos'
    (fun i hi => by rw [winK6R3W_eq]; exact snake_inducedPattern_block p i 8 hi) hw2 hw3 hw4 hw5 hw6
  rw [sumA_eq_psum] at htot
  exact htot

/-! ## 2. Windows -/

/-- Directions of window `j`: the 7 edges from vertex `j` to vertex `j+7` (the window of `hw6 j`). -/
def windowDirsK6R3W {m : Nat} (p : Snake m) (j : Nat) : List Nat :=
  [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]

/-- Share sum over the 6 centres `j+1 .. j+6` of window `j`. -/
def windowShareK6R3W {m : Nat} (p : Snake m) (j : Nat) : Nat :=
  shareSeq p (j+1) + shareSeq p (j+2) + shareSeq p (j+3) + shareSeq p (j+4) + shareSeq p (j+5) + shareSeq p (j+6)

theorem windowDirsK6R3W_eq {m : Nat} (p : Snake m) (j : Nat) : windowDirsK6R3W p j = blockList p j 7 := rfl

theorem windowShareK6R3W_eq {m : Nat} (p : Snake m) (j : Nat) : windowShareK6R3W p j = windowShareK p 6 j := by
  simp only [windowShareK6R3W, windowShareK, Finset.sum_range_succ, Finset.sum_range_zero, Nat.zero_add,
    Nat.add_zero, Nat.add_assoc, Nat.reduceAdd]

/-- Kernel check: every restricted growth string of length 7 passing the xor-mask induced test has
its code among the codes of `shapesK6R3W`. -/
theorem shareRgsK6R3W : allRGS 7 0 (fun c => (!inducedFast c || (shapesK6R3W.map shapeCode).any (Nat.beq (shapeCode c)))) = true := by
  decide +kernel

theorem shareCoverK6R3W (c : List Nat) (hc : c.length = 7) (hr : isRGS c 0 = true) :
    (!inducedFast c || (shapesK6R3W.map shapeCode).any (Nat.beq (shapeCode c))) = true :=
  allRGS_spec 7 0 _ shareRgsK6R3W c hc hr

theorem window_shape_memK6R3W {m : Nat} (p : Snake m) (j : Nat) (hj : j + 7 ≤ m) :
    canon (windowDirsK6R3W p j) ∈ shapesK6R3W := by
  rw [windowDirsK6R3W_eq]
  exact window_shape_mem_of shapesK6R3W 7 (by decide) shapesK6R3W_ok shareCoverK6R3W p j hj

/-! ## 3. The conditional 234 -/

/-- Conditional 234, plain form of the share premise: every window `j` (1 ≤ j, j + 7 ≤ m) has share
sum at least 21. -/
theorem upper_234_of_direction_windows_and_shares_allK6R3W {m : Nat} (p : Snake m)
    (hw2 : ∀ j, j + 3 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2))] = false)
    (hw3 : ∀ j, j + 4 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3))] = false)
    (hw4 : ∀ j, j + 5 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4))] = false)
    (hw5 : ∀ j, j + 6 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4)), sym (countSeq p (j+5))] = false)
    (hw6 : ∀ j, j + 7 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4)), sym (countSeq p (j+5)), sym (countSeq p (j+6))] = false)
    (hshare : ∀ j, 1 ≤ j → j + 7 ≤ m → 21 ≤ windowShareK6R3W p j) : m ≤ 234 := by
  by_cases hm : m < 7
  · omega
  have hwalk := walkK6R3W p (by omega) hw2 hw3 hw4 hw5 hw6
  exact upper_of_walk_and_shares p 4 1 28 7 6 21 234 (by omega) (by decide) (by omega) hwalk
    (fun j h1 h2 => by rw [← windowShareK6R3W_eq]; exact hshare j (by omega) (by omega)) (by decide)

/-- **Conditional 234-edge bound.**  Premises: the window exclusions of the K6R3W chain
(`hw2` .. `hw6`, unchanged) and, for each of the 34 6-centre direction shapes of the chain, that no
window of that shape has share sum at most 20.  Neither premise is proved in Lean. -/
theorem upper_234_of_direction_windows_and_sharesK6R3W {m : Nat} (p : Snake m)
    (hw2 : ∀ j, j + 3 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2))] = false)
    (hw3 : ∀ j, j + 4 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3))] = false)
    (hw4 : ∀ j, j + 5 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4))] = false)
    (hw5 : ∀ j, j + 6 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4)), sym (countSeq p (j+5))] = false)
    (hw6 : ∀ j, j + 7 ≤ m → wforbK6R3W [pathDir p j, pathDir p (j+1), pathDir p (j+2), pathDir p (j+3), pathDir p (j+4), pathDir p (j+5), pathDir p (j+6)]
      [sym (countSeq p (j+1)), sym (countSeq p (j+2)), sym (countSeq p (j+3)), sym (countSeq p (j+4)), sym (countSeq p (j+5)), sym (countSeq p (j+6))] = false)
    (hshare : ∀ s ∈ shapesK6R3W, ∀ j, 1 ≤ j → j + 7 ≤ m →
      canon (windowDirsK6R3W p j) = s → 21 ≤ windowShareK6R3W p j) : m ≤ 234 :=
  upper_234_of_direction_windows_and_shares_allK6R3W p hw2 hw3 hw4 hw5 hw6
    (fun j h1 h2 => hshare _ (window_shape_memK6R3W p j h2) j h1 h2 rfl)

